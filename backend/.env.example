# Required locally. Keep the real value only in backend/.env and never commit it.
CALLMISSED_API_KEY=replace_me
CALLMISSED_CHAT_MODEL=sarvam-105b-conversations
CALLMISSED_IMAGE_MODEL=sdxl-lightning

# Local development defaults. Production deployment will set APP_ENV=production.
APP_ENV=local
REVIEWER_GATE_ENABLED=false

# Required in production for signed reviewer sessions and voice-session leases.
# Use a long random value; do not reuse the CallMissed API key.
APP_SESSION_SECRET=

# Required only when REVIEWER_GATE_ENABLED=true.
# Store a PBKDF2 hash, not the plaintext passcode.
REVIEWER_PASSCODE_HASH=
